APP_NAME=<name>
PORT=<port>
NODE_ENV=production

# Host networking: the container shares the host's network namespace,
# so MySQL on the host is reachable at 127.0.0.1 directly.
# Do NOT use host.docker.internal — that is for bridge networking.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
