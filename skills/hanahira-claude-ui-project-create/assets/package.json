{
  "name": "<name>",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:client && bun run build:server",
    "build:client": "vite build",
    "build:server": "bun build src/server/index.ts --target=bun --outdir=dist/server",
    "start": "bun run dist/server/index.js",
    "dev": "bun run --watch src/server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.0",
    "mysql2": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
